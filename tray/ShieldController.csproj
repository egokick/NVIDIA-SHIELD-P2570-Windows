<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShieldController</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\controller.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>0.5.2</Version>
    <Product>NVIDIA SHIELD P2570 for Windows</Product>
    <Description>Wireless gamepad connection and pairing for the NVIDIA SHIELD P2570.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../contracts/ConnectionSettings.cs" Link="ConnectionSettings.cs" />
    <Compile Include="../contracts/PairingTiming.cs" Link="PairingTiming.cs" />
    <Compile Include="../contracts/ControllerFirmware.cs" Link="ControllerFirmware.cs" />
    <EmbeddedResource Include="..\assets\controller.ico" LogicalName="controller.ico" />
    <EmbeddedResource Include="..\contracts\default-controls.json" LogicalName="default-controls.json" />
  </ItemGroup>
</Project>
