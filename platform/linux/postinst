#!/bin/sh
set -eu
if [ "${1:-}" = configure ]; then
    # Only this package's device permissions are refreshed. No radio is started.
    if command -v modprobe >/dev/null 2>&1; then modprobe uinput || true; fi
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --action=change --subsystem-match=misc --sysname-match=uinput || true
        udevadm trigger --action=change --subsystem-match=usb --attr-match=idVendor=0bda --attr-match=idProduct=0811 || true
    fi
fi
