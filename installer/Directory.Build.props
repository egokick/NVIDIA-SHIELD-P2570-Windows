<Project>
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../debug/build/installer/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../debug/build/installer/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../debug/dotnet-packages</RestorePackagesPath>
  </PropertyGroup>
</Project>
